    {
      "parameters": {
        "jsCode": "// Get the AI output from the previous node\nconst aiOutput = $input.item.json.output || $input.item.json.text || $input.item.json.message || '';\n\n// Try to parse the AI response\nlet parsed = {};\nlet responseText = '';\n\ntry {\n  // Remove markdown code blocks if present\n  let clean = aiOutput.trim();\n  clean = clean.replace(/```json/g, '').replace(/```/g, '').trim();\n  \n  // Parse JSON\n  parsed = JSON.parse(clean);\n} catch (e) {\n  // If parsing fails, use fallback values\n  parsed = {\n    category: 'other',\n    summary: 'Failed to parse AI output',\n    extracted: {},\n    priority: 0,\n    task_description: null\n  };\n}\n\n// Extract fields with fallbacks\nconst extracted = parsed.extracted || {};\n\n// Return separate fields\nreturn [\n  {\n    json: {\n     \n      // AI parsed fields\n      category: parsed.category || 'other',\n      summary: parsed.summary || '',\n      priority: parsed.priority || 0,\n      task_description: parsed.task_description || null,\n      \n      // Extracted details\n      order_number: extracted.order_number || null,\n      product: extracted.product || null,\n      quantity: extracted.quantity || null,\n      deadline: extracted.deadline || null,\n      amount: extracted.amount || null,\n      name: extracted.name || null,\n      email: extracted.email || null,\n      phone: extracted.phone || null,\n      action_needed: extracted.action_needed || null,\n      \n      // Raw AI output (for debugging)\n      raw_ai_output: aiOutput.substring(0, 200)\n    }\n  }\n];"
      },
