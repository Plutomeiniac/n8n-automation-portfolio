    {
      "parameters": {
        "jsCode": "// Get the AI output from the previous node\nconst aiOutput = $input.item.json.output || $input.item.json.text || $input.item.json.message || '';\n\n// Try to parse the AI response\nlet parsed = {};\nlet responseText = '';\n\ntry {\n  // Remove markdown code blocks if present\n  let clean = aiOutput.trim();\n  clean = clean.replace(/```json/g, '').replace(/```/g, '').trim();\n  \n  // Parse JSON\n  parsed = JSON.parse(clean);\n  responseText = parsed.response || parsed.reply || '';\n} catch (e) {\n  // If parsing fails, fallback to raw text\n  responseText = aiOutput.substring(0, 500);\n  parsed = {\n    intent: 'unknown',\n    details: {},\n    response: responseText,\n    score: 0\n  };\n}\n\n// Extract details\nconst details = parsed.details || {};\n\n// Return separate fields\nreturn [\n  {\n    json: {\n      // Original data (preserved)\n      customer_id: $('normalization').first().json.cutomer_id || '',\n      customer_message: $('normalization').first().json.customer_message || '',\n      source: $('normalization').first().json.source || '',\n      \n      // AI parsed fields\n      intent: parsed.intent || 'unknown',\n      response: parsed.response || '',\n      score: parsed.score || 0,\n      \n      // Extracted details\n      product: details.product || '',\n      quantity: details.quantity || '',\n      delivery: details.delivery || '',\n      question: details.question || '',\n      interest: details.interest || '',\n      \n      // Raw AI output (for debugging)\n      raw_ai_output: aiOutput.substring(0, 200)\n    }\n  }\n];"
      },
