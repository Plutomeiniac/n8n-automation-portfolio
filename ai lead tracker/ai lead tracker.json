    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst results = [];\n\nfor (const item of items) {\n  const json = item.json;\n  \n  // PRESERVE original data\n  const originalData = {\n    customer_id: $('Edit Fields').first().json['customer id'],\n    message: $('Edit Fields').first().json.message,\n    timestamp: json.timestamp || new Date().toISOString(),\n    source: json.source || 'Instagram (Mock)'\n  };\n  \n  // Get the AI output\n  let rawOutput = json.output || json.text || json.message || JSON.stringify(json);\n  \n  // Parse the AI output\n  let parsed = {};\n  if (typeof rawOutput === 'string') {\n    try {\n      let clean = rawOutput.trim();\n      clean = clean.replace(/```json/g, '').replace(/```/g, '').trim();\n      parsed = JSON.parse(clean);\n    } catch (e) {\n      parsed = {\n        reply: rawOutput.substring(0, 200),\n        order_ready: false,\n        collected: { product: null, quantity: null, delivery: null },\n        summary: 'Failed to parse AI output'\n      };\n    }\n  } else {\n    parsed = rawOutput;\n  }\n  \n  // Ensure collected object exists\n  const collected = parsed.collected || {};\n  \n  // Combine original data + parsed AI output\n  results.push({\n    json: {\n      // ORIGINAL DATA\n      customer_id: originalData.customer_id,\n      message: originalData.message,\n      timestamp: originalData.timestamp,\n      source: $('Edit Fields').first().json.source,\n      \n      // AI OUTPUT\n      ai_reply: parsed.reply || parsed.response || '',\n      order_ready: parsed.order_ready || false,\n      \n      // COLLECTED ORDER DETAILS\n      product: collected.product || null,\n      quantity: collected.quantity || null,\n      delivery: collected.delivery || null,\n      \n      summary: parsed.summary || '',\n      \n      // Raw AI output for debugging (optional)\n      raw_ai_output: typeof rawOutput === 'string' ? rawOutput.substring(0, 200) : JSON.stringify(rawOutput).substring(0, 200)\n    }\n  });\n}\n\nreturn results;"
      },
